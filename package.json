{
  "name": "bike-jumper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @bike-jumper/web -- --host 127.0.0.1 --port 4173",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "typecheck": "npm run typecheck -w @bike-jumper/web && npm run typecheck -w @bike-jumper/schema",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:physics": "node scripts/build-physics.mjs",
    "build": "npm run build -w @bike-jumper/schema && npm run build -w @bike-jumper/web",
    "test:unit": "vitest run --passWithNoTests",
    "test:schema": "vitest run --project schema-unit packages/schema/tests/application-contracts.test.ts",
    "test:physics": "cargo test -p physics-core",
    "test:convergence": "cargo test -p physics-core --test convergence",
    "test:parity": "vitest run --project parity",
    "test:determinism": "cargo test -p physics-core --test determinism",
    "test:worker": "vitest run --project contracts tests/contracts/physics-worker.test.ts",
    "test:persistence": "vitest run --project web-unit apps/web/tests/integration/persistence.test.ts",
    "test:store": "vitest run --project web-unit apps/web/src/state/store.test.ts",
    "test:session": "vitest run --project web-unit apps/web/tests/integration/session-continuity.test.ts",
    "test:ui": "vitest run --project web-unit apps/web/tests/unit/ui-components.test.tsx",
    "test:views": "vitest run --project web-unit apps/web/tests/unit --passWithNoTests",
    "test:e2e": "playwright test tests/e2e/workbench.spec.ts tests/e2e/library.spec.ts tests/e2e/designer.spec.ts tests/e2e/report.spec.ts tests/e2e/validation.spec.ts tests/e2e/demo-journey.spec.ts --project=engine-chromium --project=engine-firefox --project=engine-webkit --project=branded-browser-chrome --project=branded-browser-edge --project=tablet --reporter=line",
    "test:e2e:views": "playwright test tests/e2e/workbench.spec.ts tests/e2e/library.spec.ts tests/e2e/designer.spec.ts tests/e2e/report.spec.ts tests/e2e/validation.spec.ts --project=engine-chromium --project=tablet --reporter=line",
    "test:visual": "playwright test tests/visual --project=visual --project=tablet --reporter=line",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts --project=web-server --reporter=line",
    "preview": "npm run preview -w @bike-jumper/web -- --host 127.0.0.1 --port 4173",
    "test:offline": "playwright test tests/offline --project=offline --reporter=line",
    "benchmark:standard": "node scripts/run-standard-benchmark.mjs --output docs/architecture/evidence/physics-spike.json",
    "benchmark:interaction": "node scripts/run-interaction-benchmark.mjs --output docs/architecture/evidence/browser-offline-spike.json",
    "security": "node scripts/security-release-gates.mjs --audit",
    "evidence:compatibility": "node scripts/generate-compatibility-report.mjs",
    "evidence:final": "node scripts/generate-final-evidence.mjs",
    "validate:decision": "node scripts/validate-stack-decision.mjs --catalog docs/architecture/evidence/catalog.json --rubric docs/architecture/stack-rubric.json --decision docs/architecture/stack-decision.json --output docs/architecture/evidence/stack-validation.json",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/node": "24.7.2",
    "eslint": "9.39.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "29.1.1",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  }
}
