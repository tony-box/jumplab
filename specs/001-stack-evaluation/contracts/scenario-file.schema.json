{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bike-jumper.local/schemas/scenario-file-v1.schema.json",
  "title": "Bike Jumper Scenario File v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "exportedBy", "scenario", "contentHash"],
  "properties": {
    "format": { "const": "bike-jumper-scenario" },
    "schemaVersion": { "const": 1 },
    "exportedBy": { "$ref": "#/$defs/versionStamp" },
    "scenario": { "$ref": "#/$defs/scenario" },
    "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "versionStamp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appVersion", "solverVersion", "exportedAt"],
      "properties": {
        "appVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+].+)?$" },
        "solverVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
        "exportedAt": { "type": "string", "format": "date-time" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "name", "jump", "rider", "bike", "entry", "poseClip", "solver"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "jump": { "$ref": "#/$defs/jump" },
        "rider": { "$ref": "#/$defs/rider" },
        "bike": { "$ref": "#/$defs/bike" },
        "entry": { "$ref": "#/$defs/entry" },
        "poseClip": { "$ref": "#/$defs/poseClip" },
        "solver": { "$ref": "#/$defs/solver" }
      }
    },
    "jump": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "lipHeight", "lipAngle", "transitionRadius", "gap", "stepDelta", "landingAngle", "landingLength", "rollout"],
      "properties": {
        "kind": { "enum": ["table", "gap", "stepup", "stepdown"] },
        "lipHeight": { "type": "number", "minimum": 0.2, "maximum": 4 },
        "lipAngle": { "type": "number", "minimum": 0.05, "maximum": 1.5 },
        "transitionRadius": { "type": "number", "minimum": 0.5, "maximum": 30 },
        "gap": { "type": "number", "minimum": 0, "maximum": 20 },
        "stepDelta": { "type": "number", "minimum": -5, "maximum": 5 },
        "landingAngle": { "type": "number", "minimum": 0.05, "maximum": 1.2 },
        "landingLength": { "type": "number", "minimum": 1, "maximum": 40 },
        "rollout": { "type": "number", "minimum": 0, "maximum": 60 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["table", "gap"] } } },
          "then": { "properties": { "stepDelta": { "const": 0 } } }
        }
      ]
    },
    "rider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["height", "mass", "legRatio", "armRatio", "strengthScale", "kp", "kd", "joints"],
      "properties": {
        "height": { "type": "number", "minimum": 1.2, "maximum": 2.2 },
        "mass": { "type": "number", "minimum": 35, "maximum": 160 },
        "legRatio": { "type": "number", "minimum": 0.35, "maximum": 0.6 },
        "armRatio": { "type": "number", "minimum": 0.3, "maximum": 0.5 },
        "strengthScale": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 },
        "kp": { "type": "number", "minimum": 0, "maximum": 5000 },
        "kd": { "type": "number", "minimum": 0, "maximum": 500 },
        "joints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ankle", "knee", "hip", "spine", "shoulder", "elbow"],
          "properties": {
            "ankle": { "$ref": "#/$defs/jointLimit" },
            "knee": { "$ref": "#/$defs/jointLimit" },
            "hip": { "$ref": "#/$defs/jointLimit" },
            "spine": { "$ref": "#/$defs/jointLimit" },
            "shoulder": { "$ref": "#/$defs/jointLimit" },
            "elbow": { "$ref": "#/$defs/jointLimit" }
          }
        }
      }
    },
    "jointLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "tauMax"],
      "properties": {
        "min": { "type": "number", "minimum": -3.141593, "maximum": 3.141593 },
        "max": { "type": "number", "minimum": -3.141593, "maximum": 3.141593 },
        "tauMax": { "type": "number", "minimum": 0, "maximum": 2000 }
      }
    },
    "bike": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frameType", "wheelSize", "wheelbase", "chainstay", "bbHeight", "mass", "fork", "rearShock"],
      "properties": {
        "frameType": { "enum": ["rigid", "hardtail", "full"] },
        "wheelSize": { "enum": [26, 27.5, 29] },
        "wheelbase": { "type": "number", "minimum": 0.8, "maximum": 1.5 },
        "chainstay": { "type": "number", "minimum": 0.3, "maximum": 0.65 },
        "bbHeight": { "type": "number", "minimum": 0.2, "maximum": 0.5 },
        "mass": { "type": "number", "minimum": 5, "maximum": 30 },
        "fork": { "$ref": "#/$defs/suspension" },
        "rearShock": {
          "oneOf": [
            { "$ref": "#/$defs/suspension" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "frameType": { "const": "full" } } },
          "then": { "properties": { "rearShock": { "$ref": "#/$defs/suspension" } } },
          "else": { "properties": { "rearShock": { "type": "null" } } }
        }
      ]
    },
    "suspension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["travel", "sag", "springRate", "damping"],
      "properties": {
        "travel": { "type": "number", "minimum": 0, "maximum": 0.3 },
        "sag": { "type": "number", "minimum": 0, "maximum": 0.12 },
        "springRate": { "type": "number", "minimum": 0, "maximum": 100000 },
        "damping": { "type": "number", "minimum": 0, "maximum": 10000 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["speed", "startX"],
      "properties": {
        "speed": { "type": "number", "minimum": 0.5, "maximum": 30 },
        "startX": { "type": "number", "minimum": -100, "maximum": -0.1 }
      }
    },
    "poseClip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "interpolation", "keys"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "interpolation": { "enum": ["cubic", "linear", "step"] },
        "keys": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/poseKey" }
        }
      }
    },
    "poseKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["s", "label", "targets"],
      "properties": {
        "s": { "type": "number", "minimum": -50, "maximum": 50 },
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "targets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ankle", "knee", "hip", "spine"],
          "properties": {
            "ankle": { "$ref": "#/$defs/angle" },
            "knee": { "$ref": "#/$defs/angle" },
            "hip": { "$ref": "#/$defs/angle" },
            "spine": { "$ref": "#/$defs/angle" }
          }
        }
      }
    },
    "angle": {
      "type": "number",
      "minimum": -3.141593,
      "maximum": 3.141593
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dt", "substeps", "ccd", "seed", "outputHz", "solverVersion"],
      "properties": {
        "dt": { "enum": [0.0010416666666666667, 0.0020833333333333333, 0.004166666666666667, 0.008333333333333333, 0.016666666666666666] },
        "substeps": { "type": "integer", "minimum": 1, "maximum": 16 },
        "ccd": { "type": "boolean" },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "outputHz": { "enum": [60, 120, 240, 480, 960] },
        "solverVersion": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    }
  }
}
